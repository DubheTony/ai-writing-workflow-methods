# Keep the repository focused on public documentation and generic tools.
/*
!/.gitignore
!/README.md
!/README.en.md
!/LICENSE
!/docs/
!/docs/*.md
!/src/
!/src/*.py

# Exclude common local data and generated files.
/data/
/datasets/
/private/
/outputs/
/.venv/
/__pycache__/

# Do not add source documents or media files to the methods repository.
*.docx
*.pptx
*.xlsx
*.pdf
*.wav
*.mp3
*.m4a
*.mp4
*.mov
*.heic
*.jpg
*.jpeg
*.png
*.webp
